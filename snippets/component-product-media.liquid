{% comment %}
  Accepts:
  - media: {Object} Product Media object
  - loop: {Boolean} Enable video looping (optional)

  Usage:
  {% render 'component-product-media',
    media: media,
    loop: section.settings.enable_video_looping
  %}
{% endcomment %}

{% case media.media_type %}
  {% when 'image' %}
    {% assign image_style1 = 'max-height: ' | append: image_max_height %}
    {{
      media
      | image_url: width: media.width
      | image_tag:
        width: media.width,
        height: media.height,
        loading: 'eager',
        alt: media.alt,
        data-media-id: media.id,
        class: 'image-magnify-hover',
        style: image_style1
    }}

  {% when 'external_video' %}
    {{ media | external_video_tag }}
    
  {% when 'video' %}
    {% if styles %}
      {% assign dimensions = 'width: 7.212vw; height: 7.212vw;' %}
    {% else %}
      {% assign dimensions = '' %}
    {% endif %}
    {{ media | media_tag: image_size: '2024x', autoplay: true, loop: loop, controls: v_controls, preload: 'none', data-media-id: media.id, style: dimensions }}

  {% when 'model' %}
    {{ media | model_viewer_tag }}

  {% else %}
    {{ media | media_tag }}
{% endcase %}
